{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noEmit": true,
    "rootDir": "..",
    "paths": {
      "test-app/tests/*": ["./tests/*"],
      "test-app/*": ["./app/*"],
      "@upfluence/hyperevents": ["../hyperevents/src"],
      "@upfluence/hyperevents/*": ["../hyperevents/src/*"],
      "@upfluence/hyperevents/test-support": ["../hyperevents/src/test-support"],
      "@upfluence/hyperevents/test-support/*": ["../hyperevents/src/test-support/*"],
      "*": ["./types/*"]
    }
  },
  "include": ["app/**/*", "tests/**/*", "types/**/*", "../hyperevents/src/**/*"]
}
