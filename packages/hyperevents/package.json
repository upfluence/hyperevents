{
  "name": "@upfluence/hyperevents",
  "version": "1.0.0-beta.1",
  "description": "Ember addon for activity tracking and websocket event subscriptions.",
  "keywords": [
    "ember-addon"
  ],
  "repository": "https://github.com/upfluence/hyperevents",
  "license": "MIT",
  "author": "Upfluence <dev@upfluence.com>",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rollup --config",
    "build:analyze": "DEBUG=true rollup --config --perf",
    "lint": "prettier . --cache --check && ESLINT_USE_FLAT_CONFIG=false eslint . --cache && ember-template-lint .",
    "lint:fix": "prettier . --cache --write && ESLINT_USE_FLAT_CONFIG=false eslint . --cache --fix && ember-template-lint . --fix",
    "lint:types": "glint",
    "prepack": "rollup --config",
    "start": "rollup --config --watch",
    "test": "pnpm build"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.0",
    "@embroider/macros": "1.11.1",
    "@glimmer/tracking": "^1.0.0",
    "decorator-transforms": "^2.3.0",
    "ember-modifier": "3.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-typescript": "^7.24.0",
    "@babel/runtime": "^7.24.0",
    "@embroider/addon-dev": "7.1.6",
    "@glint/core": "^1.5.2",
    "@glint/environment-ember-loose": "^1.5.2",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@types/ember__application": "^3.16.3",
    "@types/ember__component": "^3.16.6",
    "@types/ember__debug": "^3.16.5",
    "@types/ember__runloop": "^3.16.3",
    "@types/ember__service": "^3.16.1",
    "@types/ember__utils": "^3.16.2",
    "@types/htmlbars-inline-precompile": "^1.0.1",
    "@typescript-eslint/parser": "^5.9.1",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@upfluence/w-conf": "^0.2.0",
    "babel-plugin-ember-template-compilation": "^2.2.1",
    "ember-cli-babel": "^7.19.0",
    "ember-cli-htmlbars": "^4.3.1",
    "ember-source": "~3.28.12",
    "ember-template-lint": "^2.6.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-ember": "^10.5.8",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.1",
    "prettier": "^3.0.0",
    "rollup": "^4.24.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "^4.9.5"
  },
  "peerDependencies": {
    "ember-source": ">=3.28"
  },
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./configuration": {
      "types": "./declarations/configuration.d.ts",
      "default": "./dist/configuration.js"
    },
    "./decorators/log-construction": {
      "types": "./declarations/decorators/log-construction.d.ts",
      "default": "./dist/decorators/log-construction.js"
    },
    "./helpers/log-activity": {
      "types": "./declarations/helpers/log-activity.d.ts",
      "default": "./dist/helpers/log-activity.js"
    },
    "./helpers/observable": {
      "types": "./declarations/helpers/observable.d.ts",
      "default": "./dist/helpers/observable.js"
    },
    "./helpers/observer-group": {
      "types": "./declarations/helpers/observer-group.d.ts",
      "default": "./dist/helpers/observer-group.js"
    },
    "./modifiers/log-deletion": {
      "types": "./declarations/modifiers/log-deletion.d.ts",
      "default": "./dist/modifiers/log-deletion.js"
    },
    "./modifiers/log-insertion": {
      "types": "./declarations/modifiers/log-insertion.d.ts",
      "default": "./dist/modifiers/log-insertion.js"
    },
    "./services/activity-tracking": {
      "types": "./declarations/services/activity-tracking.d.ts",
      "default": "./dist/services/activity-tracking.js"
    },
    "./services/events-service": {
      "types": "./declarations/services/events-service.d.ts",
      "default": "./dist/services/events-service.js"
    },
    "./test-support/services/events-service": {
      "types": "./declarations/test-support/services/events-service.d.ts",
      "default": "./dist/test-support/services/events-service.js"
    },
    "./addon-main.js": "./addon-main.cjs",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "declarations/*"
      ]
    }
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./decorators/log-construction.js": "./dist/_app_/decorators/log-construction.js",
      "./helpers/log-activity.js": "./dist/_app_/helpers/log-activity.js",
      "./helpers/observable.js": "./dist/_app_/helpers/observable.js",
      "./helpers/observer-group.js": "./dist/_app_/helpers/observer-group.js",
      "./modifiers/log-deletion.js": "./dist/_app_/modifiers/log-deletion.js",
      "./modifiers/log-insertion.js": "./dist/_app_/modifiers/log-insertion.js",
      "./services/activity-tracking.js": "./dist/_app_/services/activity-tracking.js",
      "./services/events-service.js": "./dist/_app_/services/events-service.js"
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist"
  ]
}
