{
  "private": true,
  "repository": "https://github.com/upfluence/hyperevents",
  "license": "UNLICENSED",
  "author": "Upfluence <dev@upfluence.com>",
  "scripts": {
    "build": "pnpm --filter @upfluence/hyperevents build",
    "lint": "pnpm --filter @upfluence/hyperevents --filter test-app lint",
    "lint:fix": "pnpm --filter @upfluence/hyperevents --filter test-app lint:fix",
    "lint:types": "pnpm --filter @upfluence/hyperevents --filter test-app lint:types",
    "start": "concurrently \"pnpm:start:*\" --restart-after 5000 --prefix-colors cyan,white,yellow",
    "start:addon": "pnpm --filter @upfluence/hyperevents start",
    "start:test-app": "pnpm --filter test-app start",
    "test": "pnpm --filter @upfluence/hyperevents --filter test-app test",
    "test:ember-compatibility": "pnpm --filter test-app test:ember-compatibility"
  },
  "devDependencies": {
    "@release-it-plugins/workspaces": "^3.2.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@upfluence/w-conf": "^0.4.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "release-it": "^15.9.3"
  },
  "release-it": {
    "plugins": {
      "@release-it-plugins/workspaces": {
        "skipChecks": true,
        "publish": false,
        "workspaces": [
          "hyperevents"
        ],
        "additionalManifests": {
          "versionUpdates": [
            "packages/hyperevents/package.json"
          ]
        }
      }
    },
    "npm": false
  },
  "engines": {
    "node": "20.* || >= 22",
    "pnpm": ">= 10"
  }
}
